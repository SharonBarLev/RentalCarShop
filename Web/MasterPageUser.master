<%@ Master Language="C#" AutoEventWireup="true" CodeFile="MasterPageUser.master.cs" Inherits="MasterPageUser" %>

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <title>ByteForge</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <meta content="" name="keywords">
    <meta content="" name="description">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600;700&family=Roboto:wght@400;500;700&display=swap" rel="stylesheet"> 

    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.15.4/css/all.css"/>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <link href="lib/animate/animate.min.css" rel="stylesheet">
    <link href="lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet">

    <link href="css/bootstrap.min.css" rel="stylesheet">

    <link href="css/style.css" rel="stylesheet">
    <style>
        body {
            background-color: #1c1c22;
            color: #f1f1f5;
        }

        .bg-primary {
            background-color: #7c3aed !important;
        }

        .text-primary {
            color: #7c3aed !important;
        }

        .btn-primary {
            background-color: #7c3aed !important;
            border-color: #7c3aed !important;
        }

        .btn-primary:hover {
            background-color: #6d28d9 !important;
            border-color: #6d28d9 !important;
        }

        .bg-secondary {
            background-color: #a855f7 !important;
        }

        .text-secondary {
            color: #a855f7 !important;
        }

        .btn-secondary {
            background-color: #a855f7 !important;
            border-color: #a855f7 !important;
            color: #fff !important;
        }

        .btn-secondary:hover {
            background-color: #9333ea !important;
            border-color: #9333ea !important;
        }

        .navbar {
            background-color: #7c3aed !important;
        }

        .navbar .nav-link {
            color: #ffffff !important;
            transition: all 0.3s ease;
            position: relative; 
            border-bottom: none !important; 
        }

        .navbar .gradient-btn {
            position: relative;
        }

        .navbar .nav-link::after,
        .navbar .gradient-btn::after {
            content: '';
            position: absolute;
            left: 0;
            right: 0;
            height: 3px; 
            background-color: #ffffff;
            bottom: 12px; 
            transform: scaleX(0);
            opacity: 0;
            transition: all 0.3s ease;
        }

        .navbar .gradient-btn::after {
            bottom: 5px; 
            width: 80%; 
            margin: 0 auto;
        }

        .navbar .nav-link:hover,
        .navbar .nav-link.active {
            color: #e9d5ff !important;
        }

        .navbar .nav-link:hover::after,
        .navbar .nav-link.active::after,
        .navbar .gradient-btn:hover::after,
        .navbar .gradient-btn.active::after {
            transform: scaleX(1);
            opacity: 1;
        }

        .page-header {
            background-color: #23232b;
        }

        .contact {
            background-color: #1c1c22;
        }

        .footer {
            background-color: #18181c;
        }

        .footer h4 {
            color: #7c3aed !important;
            text-align: center;
            position: relative;
            padding-bottom: 15px;
            margin-bottom: 25px;
        }

        .footer h4::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 60px;
            height: 3px;
            background: linear-gradient(90deg, #8b5cf6, #06b6d4);
            border-radius: 2px;
        }

        .footer a {
            color: #c4b5fd !important;
            text-align: left;
            display: block;
            padding: 8px 0;
            transition: all 0.4s ease;
            position: relative;
            text-decoration: none;
        }

        .footer a:hover {
            color: #06b6d4;
            text-shadow: 0 0 10px rgba(6, 182, 212, 0.5);
            transform: translateX(5px);
        }

        .footer a:hover i {
            color: #8b5cf6;
            transform: rotate(360deg);
            transition: transform 0.6s ease;
        }

        .footer a i {
            transition: all 0.4s ease;
        }

        .copyright {
            background-color: #111114;
        }

        #spinner {
            background-color: #1c1c22 !important;
        }

        .back-to-top {
            background-color: #7c3aed !important;
            border-color: #7c3aed !important;
        }

        .back-to-top:hover {
            background-color: #6d28d9 !important;
        }
        .copyright span, .copyright a {
            color: #ffffff !important;
        }
        .copyright {
            background-color: #7c3aed !important;
        }
        
        .gradient-btn {
            background: linear-gradient(45deg, #00aaff 0%, #9900ff 100%);
            color: #fff; 
            padding: 10px 25px;
            border: none;
            border-radius: 50px; 
            cursor: pointer;
            font-weight: bold;
            transition: all 0.3s ease;
            text-decoration: none; 
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .gradient-btn:hover {
            opacity: 0.9;
            color: #fff !important; 
        }

        .outline-dark-btn {
            background: rgba(255, 255, 255, 0.03);
            color: #f1f1f5;
            padding: 10px 25px;
            border: 2px solid rgba(124, 58, 237, 0.5);
            border-radius: 50px;
            cursor: pointer;
            font-weight: bold;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .outline-dark-btn:hover {
            background: #7c3aed; 
            color: #fff !important;
            border-color: #7c3aed;
            box-shadow: 0 0 15px rgba(124, 58, 237, 0.4);
        }

        .gradient-btn-square {
            background: linear-gradient(45deg, #00aaff 0%, #9900ff 100%);
            color: #fff;
            width: 50px;
            height: 50px;
            border-radius: 50px;
            border: none;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s ease;
        }

        .gradient-btn-square:hover {
            opacity: 0.9;
        }
    </style>
</head>

<body>
<form id="frm10" runat="server">

<div id="spinner" class="show bg-white position-fixed translate-middle w-100 vh-100 top-50 start-50 d-flex align-items-center justify-content-center">
    <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
        <span class="sr-only">Loading...</span>
    </div>
</div>
<div class="container-fluid px-5 py-3 d-none d-lg-block" style="background-color: #1c1c22;">
    <div class="d-flex align-items-center justify-content-between" style="height: 80px; width: 100%;"> 
        
        <div style="flex-shrink: 0;">
            <a href="HomeUser.aspx" class="navbar-brand p-0 m-0">
                <h1 class="text-white m-0 d-flex align-items-center" style="font-size: 2.5rem; line-height: 1;">
                    <i class="fas fa-shopping-bag text-secondary me-2"></i>ByteForge
                </h1>
            </a>
        </div>

        <div style="width: 45%; min-width: 350px;">
            <div class="input-group" style="height: 50px;"> 
                <asp:TextBox ID="txtMasterSearch" runat="server" CssClass="form-control text-white ps-4" 
                             placeholder="Search for components, PC sets..." 
                             style="background: rgba(255,255,255,0.05); 
                                    border: 2px solid #7c3aed; 
                                    border-radius: 50px 0 0 50px; 
                                    border-right: none; 
                                    height: 100%;"></asp:TextBox>
                
                <asp:Button ID="btnMasterSearch" runat="server" OnClick="GlobalSearch_Click"
                            style="background: linear-gradient(45deg, #00aaff 0%, #9900ff 100%); 
                                   border: 2px solid #7c3aed; 
                                   border-left: none;
                                   color: white; 
                                   border-radius: 0 50px 50px 0; 
                                   height: 100%; 
                                   font-weight: bold;
                                   padding-left: 1.5rem;
                                   padding-right: 1.5rem;" 
                            Text="&#xf002;" CssClass="btn fa" />
            </div>
        </div>

        <div style="flex-shrink: 0;">
            <a href="AccountUser.aspx" class="outline-dark-btn" style="height: 50px; font-size: 0.9rem; white-space: nowrap;">
                <i class="fas fa-user-circle me-2"></i>My Account
            </a>
        </div>

    </div>
</div>
<div class="container-fluid nav-bar p-0">
    <div class="row gx-0 bg-primary px-5 align-items-center">

        <div class="col-12">
            <nav class="navbar navbar-expand-lg navbar-light bg-primary">
                <a href="" class="navbar-brand d-block d-lg-none">
                    <h1 class="display-5 text-secondary m-0">
                        <i class="fas fa-shopping-bag text-white me-2"></i>Electro
                    </h1>
                </a>
                <button class="navbar-toggler ms-auto" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
                    <span class="fa fa-bars fa-1x"></span>
                </button>
                
                <div class="collapse navbar-collapse" id="navbarCollapse">
                    <div id="navbarLinksContainer" runat="server" class="navbar-nav ms-auto py-0">
                        <a runat="server" href="HomeUser.aspx" class="nav-item nav-link">Home</a>
                        <a runat="server" href="ShopUser.aspx" class="nav-item nav-link">Shop</a>
                        <a runat="server" href="CartUser.aspx" class="nav-item nav-link">
                            <i class="fas fa-shopping-cart"></i> Cart
                        </a>
                        <asp:LinkButton ID="btnLogout" runat="server" OnClick="btnLogout_Click" CssClass="nav-item nav-link text-danger">Logout</asp:LinkButton>
                        <a runat="server" href="AboutUsUser.aspx" class="nav-item nav-link">About Us</a>
                        <a runat="server" href="ForgePCUser.aspx" class="nav-item nav-link">ForgePC</a>
                    </div>
                    
                    <a href="ContactUser.aspx" class="gradient-btn ms-lg-3 <%= Request.Url.AbsolutePath.EndsWith("ContactVisitor.aspx") ? "active" : "" %>">
                        <i class="fas fa-envelope me-2"></i> Contact
                    </a>
                </div>
            </nav>
        </div>
    </div>
</div>
<div class="container-fluid contact py-5">
    <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server"></asp:ContentPlaceHolder>
</div>
<div class="container-fluid footer py-5 wow fadeIn" data-wow-delay="0.2s">
    <div class="container py-5">
        <div class="row g-5">
            <div class="col-md-6 col-lg-6">
                <div class="footer-item d-flex flex-column">
                    <h4 class="mb-4">Customer & Account</h4>
                    <a href="HomeUser.aspx"><i class="fas fa-angle-right me-2"></i> Home Dashboard</a>
                    <a href="AccountUser.aspx"><i class="fas fa-angle-right me-2"></i> My Account</a>
                    <a href="ContactUser.aspx"><i class="fas fa-angle-right me-2"></i> Contact Us</a>
                    <a href="CartUser.aspx"><i class="fas fa-angle-right me-2"></i> View Cart</a>
                </div>
            </div>
            <div class="col-md-6 col-lg-6">
                <div class="footer-item d-flex flex-column">
                    <h4 class="mb-4">Information</h4>
                    <a href="AboutUsUser.aspx"><i class="fas fa-angle-right me-2"></i> About Us</a>
                    <a href="ShopUser.aspx"><i class="fas fa-angle-right me-2"></i> Shop Components</a>
                    <a href="ForgePCUser.aspx"><i class="fas fa-angle-right me-2"></i> Forge Your PC</a>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="container-fluid copyright py-4">
    <div class="container">
        <div class="row g-4 align-items-center">
            <div class="col-md-6 text-center text-md-start mb-md-0">
                <span class="text-white">
                    <a href="HomeUser.aspx" class="border-bottom" style="color:#7c3aed;">
                        <i class="fas fa-copyright me-2"></i>ByteForge
                    </a>, All right reserved.
                </span>
            </div>
            <div class="col-md-6 text-center text-md-end text-white">
            </div>
        </div>
    </div>
</div>
<a href="#" class="gradient-btn-square back-to-top">
    <i class="fa fa-arrow-up"></i>
</a>

<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.js"></script>
<script src="lib/wow/wow.min.js"></script>
<script src="lib/owlcarousel/owl.carousel.min.js"></script>

<script src="js/main.js"></script>

<script>
    $(document).ready(function () {
        var url = window.location.pathname;
        var pageName = url.substring(url.lastIndexOf('/') + 1);

        if (pageName === "") {
            pageName = "HomeUser.aspx";
        }

        $('.navbar-nav a, .navbar .gradient-btn, .outline-dark-btn').each(function () {
            var href = $(this).attr('href');

            if (href && href.indexOf(pageName) !== -1) {
                $(this).addClass('active');
            }
        });
    });
</script>

</form>
</body>
</html>