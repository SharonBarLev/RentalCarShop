<Window x:Class="WpfApp1.ReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WpfApp1" 
        Title="Product Reviews Manager" 
        Height="650" 
        Width="900" Background="#FF0F172A" 
        WindowStartupLocation="CenterScreen" 
        FontFamily="Segoe UI">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="240"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Product Reviews Manager" Foreground="#F8FAFC" FontSize="22" FontWeight="Bold" Margin="0,0,0,15" Grid.Row="0"/>

            <DataGrid x:Name="ReviewGrid" Grid.Row="1" AutoGenerateColumns="False" Background="#1E293B" 
                      RowBackground="#1E293B" AlternatingRowBackground="#1E293B" Foreground="White"
                      BorderBrush="#334155" HorizontalGridLinesBrush="#334155" VerticalGridLinesBrush="#334155"
                      SelectionChanged="ReviewGrid_SelectionChanged" GridLinesVisibility="Horizontal" IsReadOnly="True"
                      ColumnWidth="*">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#0F172A"/>
                        <Setter Property="Foreground" Value="#94A3B8"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#334155"/>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="10"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Review ID" Binding="{Binding MyReviewID}" Width="1*"/>
                    <DataGridTextColumn Header="Username" Binding="{Binding MyUsername}" Width="1.5*"/>
                    <DataGridTextColumn Header="Product ID" Binding="{Binding MyProductID}" Width="1.2*"/>
                    <DataGridTextColumn Header="Rating" Binding="{Binding MyRating}" Width="1*"/>
                    <DataGridTextColumn Header="Review Comment" Binding="{Binding MyRev}" Width="3.5*"/>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="2" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" Padding="20" CornerRadius="8" Margin="0,20,0,0" VerticalAlignment="Top">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="5,0,5,15">
                        <TextBlock Text="Target Review ID (Update/Del):" Foreground="#F59E0B" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="13"/>
                        <TextBox x:Name="TxtTargetReviewID" Width="120" Height="32" Background="#334155" BorderBrush="#475569" Foreground="White" FontWeight="Bold" Padding="6,4" VerticalAlignment="Center"/>
                        <TextBlock Text="* Leave blank or 0 for a new review submission" Foreground="#64748B" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="5,6">
                        <TextBlock Text="Username" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtUsername" Height="32" Background="#FF1E293B" Foreground="White" BorderBrush="#FF334155" Padding="6,4"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="5,6">
                        <TextBlock Text="Product ID" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtProductID" Height="32" Background="#FF1E293B" Foreground="White" BorderBrush="#FF334155" Padding="6,4"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="5,6">
                        <TextBlock Text="Rating (1 - 5 Stars)" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbRating" Height="32" Background="#FF1E293B" Foreground="White" BorderBrush="#FF334155" SelectedIndex="4">
                            <ComboBox.Resources>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="Background" Value="#1E293B"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Padding" Value="8,4"/>
                                </Style>
                            </ComboBox.Resources>
                            <ComboBoxItem Content="1 - Poor"/>
                            <ComboBoxItem Content="2 - Fair"/>
                            <ComboBoxItem Content="3 - Good"/>
                            <ComboBoxItem Content="4 - Very Good"/>
                            <ComboBoxItem Content="5 - Excellent"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="5,6">
                        <TextBlock Text="Review Comment" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtRev" Height="32" Background="#FF1E293B" Foreground="White" BorderBrush="#FF334155" Padding="6,4"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,30,0,0">
                        <Button x:Name="BtnAdd" Content="Add Review" Width="120" Height="38" Margin="6" Background="#10B981" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="BtnAdd_Click" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button x:Name="BtnUpdate" Content="Update" Width="120" Height="38" Margin="6" Background="#2563EB" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="BtnUpdate_Click" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button x:Name="BtnDelete" Content="Delete" Width="120" Height="38" Margin="6" Background="#EF4444" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="BtnDelete_Click" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button x:Name="BtnClear" Content="Clear" Width="90" Height="38" Margin="6" Background="#475569" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Click="BtnClear_Click" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>