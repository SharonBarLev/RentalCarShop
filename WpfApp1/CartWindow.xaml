<Window x:Class="WpfApp1.CartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WpfApp1" 
        Title="Shopping Carts Manager" 
        Height="650" 
        Width="1150" 
        Background="#FF0F172A" 
        WindowStartupLocation="CenterScreen" 
        FontFamily="Segoe UI">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="240"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,0,0,15">
                <TextBlock Text="Global Shopping Carts Manager" Foreground="#F8FAFC" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
                <Border Background="#1E293B" CornerRadius="6" Padding="10,4" Margin="25,0,0,0" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Cart Items Count: " Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock x:Name="LblTotalItems" Text="0" Foreground="#38BDF8" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Background="#1E293B" CornerRadius="6" Padding="10,4" Margin="10,0,0,0" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Est. Cart Value: " Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock x:Name="LblTotalValue" Text="$0.00" Foreground="#10B981" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <DataGrid x:Name="CartGrid" Grid.Row="1" AutoGenerateColumns="False" Background="#1E293B" 
                      RowBackground="#1E293B" AlternatingRowBackground="#1E293B" Foreground="White"
                      BorderBrush="#334155" HorizontalGridLinesBrush="#334155" VerticalGridLinesBrush="#334155"
                      SelectionChanged="CartGrid_SelectionChanged" GridLinesVisibility="Horizontal" IsReadOnly="True">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#0F172A"/>
                        <Setter Property="Foreground" Value="#94A3B8"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#334155"/>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="10"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Customer Username" Binding="{Binding MyUsername}" Width="180">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Product ID" Binding="{Binding MyProductID}" Width="120"/>
                    <DataGridTextColumn Header="Unit Price" Binding="{Binding MyPrice, StringFormat={}{0:C}}" Width="140"/>
                    <DataGridTextColumn Header="Quantity" Binding="{Binding MyQuantity}" Width="120"/>

                    <DataGridTextColumn Header="Total Line Value" Width="150">
                        <DataGridTextColumn.Binding>
                            <Binding Path="MyPrice"/>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Grid Grid.Row="2" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.7*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" Padding="20" CornerRadius="8" Margin="0,0,10,0" VerticalAlignment="Top">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="5,6">
                            <TextBlock Text="Customer Username (Key)" Foreground="#F59E0B" FontWeight="Bold" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtUsername" Height="32" Background="#0F172A" Foreground="White" BorderBrush="#475569" Padding="6,4" FontWeight="Bold"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="5,6">
                            <TextBlock Text="Product ID (Key)" Foreground="#F59E0B" FontWeight="Bold" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtProductID" Height="32" Background="#0F172A" Foreground="White" BorderBrush="#475569" Padding="6,4" FontWeight="Bold"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="5,6">
                            <TextBlock Text="Quantity" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtQuantity" Height="32" Background="#FF1E293B" Foreground="White" BorderBrush="#FF334155" Padding="6,4"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="5,6">
                            <TextBlock Text="Override Unit Price ($)" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtPrice" Height="32" Background="#FF1E293B" Foreground="White" BorderBrush="#FF334155" Padding="6,4"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="5,10,5,0">
                            <TextBlock Text="Quick Steps:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12"/>
                            <Button x:Name="BtnPlusOne" Content="+ 1 Item" Click="BtnPlusOne_Click" Width="85" Height="26" Background="#334155" Foreground="White" BorderThickness="0" Margin="2,0" Cursor="Hand"/>
                            <Button x:Name="BtnMinusOne" Content="- 1 Item" Click="BtnMinusOne_Click" Width="85" Height="26" Background="#334155" Foreground="White" BorderThickness="0" Margin="2,0" Cursor="Hand"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,25,0,5">
                            <Button x:Name="BtnAdd" Content="Add to Cart" Width="110" Height="38" Margin="5" Background="#10B981" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="BtnAdd_Click" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button x:Name="BtnUpdate" Content="Update Qty" Width="110" Height="38" Margin="5" Background="#2563EB" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="BtnUpdate_Click" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button x:Name="BtnDelete" Content="Remove Item" Width="110" Height="38" Margin="5" Background="#EF4444" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="BtnDelete_Click" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button x:Name="BtnClear" Content="Clear" Width="80" Height="38" Margin="5" Background="#475569" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Click="BtnClear_Click" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1">
                    <Border Background="#1E293B" BorderBrush="#DC2626" BorderThickness="1.5" Padding="15" CornerRadius="8" Margin="10,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Discontinued Product Purge" Foreground="#EF4444" FontWeight="Bold" FontSize="14" Margin="0,0,0,4"/>
                            <TextBlock Text="Deletes a specific product from ALL active users' shopping carts simultaneously if it is no longer sold." Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>

                            <TextBlock Text="Target Product ID to Purge:" Foreground="#F8FAFC" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtPurgeProductID" Height="32" Background="#0F172A" Foreground="White" BorderBrush="#334155" Padding="6,4" FontWeight="Bold" Margin="0,0,0,15"/>

                            <Button x:Name="BtnPurgeFromAllCarts" Content="Purge From All Carts" Click="BtnPurgeFromAllCarts_Click" Height="38" Background="#DC2626" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" Padding="15" CornerRadius="8" Margin="10,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Wipe Entire Customer Cart" Foreground="#E2E8F0" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"/>
                            <Button x:Name="BtnWipeUserCart" Content="Empty Entire User Cart" Click="BtnWipeUserCart_Click" Height="34" Background="#7C2D12" Foreground="#FDBA74" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Window>