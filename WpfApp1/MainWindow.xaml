<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Admin Dashboard"
        Height="550"
        Width="850"
        Background="#FF0F172A"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" VerticalAlignment="Top" HorizontalAlignment="Left">
            <TextBlock x:Name="WelcomeHeader"
                       Text="ADMIN DASHBOARD"
                       Foreground="#F8FAFC"
                       FontSize="26"
                       FontWeight="ExtraBold"/>

            <Label x:Name="StatusLabel"
                   Content=""
                   Foreground="#94A3B8"
                   FontSize="14"
                   Margin="0,5,0,0"/>
        </StackPanel>

        <UniformGrid Grid.Row="1" Rows="3" Columns="4" VerticalAlignment="Stretch" Margin="0,40,0,0">

            <Button Content="Products" 
                    Margin="10" Background="#1E293B" Foreground="#E2E8F0" BorderBrush="#334155" BorderThickness="1"
                    FontSize="16" FontWeight="SemiBold" Cursor="Hand" Click="OpenProducts_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Button Content="Brands" 
                    Margin="10" Background="#1E293B" Foreground="#E2E8F0" BorderBrush="#334155" BorderThickness="1"
                    FontSize="16" FontWeight="SemiBold" Cursor="Hand" Click="OpenBrands_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Button Content="Categories" 
                    Margin="10" Background="#1E293B" Foreground="#E2E8F0" BorderBrush="#334155" BorderThickness="1"
                    FontSize="16" FontWeight="SemiBold" Cursor="Hand" Click="OpenCategories_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Button Content="Contact" 
                    Margin="10" Background="#1E293B" Foreground="#E2E8F0" BorderBrush="#334155" BorderThickness="1"
                    FontSize="16" FontWeight="SemiBold" Cursor="Hand" Click="OpenContacts_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Button Content="Users" 
                    Margin="10" Background="#1E293B" Foreground="#E2E8F0" BorderBrush="#334155" BorderThickness="1"
                    FontSize="16" FontWeight="SemiBold" Cursor="Hand" Click="OpenUsers_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Button Content="Orders" 
                    Margin="10" Background="#1E293B" Foreground="#E2E8F0" BorderBrush="#334155" BorderThickness="1"
                    FontSize="16" FontWeight="SemiBold" Cursor="Hand" Click="OpenOrders_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Button Content="Order Details" 
                    Margin="10" Background="#1E293B" Foreground="#E2E8F0" BorderBrush="#334155" BorderThickness="1"
                    FontSize="16" FontWeight="SemiBold" Cursor="Hand" Click="OpenOrderDetails_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Button Content="Cart" 
                    Margin="10" Background="#1E293B" Foreground="#E2E8F0" BorderBrush="#334155" BorderThickness="1"
                    FontSize="16" FontWeight="SemiBold" Cursor="Hand" Click="OpenCarts_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Button Content="Reviews" 
                    Margin="10" Background="#1E293B" Foreground="#E2E8F0" BorderBrush="#334155" BorderThickness="1"
                    FontSize="16" FontWeight="SemiBold" Cursor="Hand" Click="OpenReviews_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Button Content="Shipping" 
                    Margin="10" Background="#1E293B" Foreground="#E2E8F0" BorderBrush="#334155" BorderThickness="1"
                    FontSize="16" FontWeight="SemiBold" Cursor="Hand" Click="OpenShippingAddresses_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>

        </UniformGrid>
    </Grid>
</Window>